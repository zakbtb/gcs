# Copiez ce fichier en .env.local et complétez les valeurs.

# Adresse publique du site (sans / final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Espace admin (/admin) ----------
# Mot de passe de l'espace admin : choisissez-en un long et unique !
ADMIN_PASSWORD=changez-moi-tout-de-suite
# Clé secrète pour signer la session admin (longue chaîne aléatoire, ex. : openssl rand -hex 32)
ADMIN_SECRET=remplacez-par-une-longue-chaine-aleatoire

# ---------- Paiement Stripe ----------
# Clés disponibles sur https://dashboard.stripe.com/test/apikeys (mode test : sk_test_ / pk_test_)
# Sans ces clés, la boutique fonctionne en « mode démo » (paiement simulé, aucun débit).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Secret du webhook (https://dashboard.stripe.com/test/webhooks) – endpoint : /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# ---------- E-mails (SMTP) ----------
# Sans SMTP, les e-mails sont enregistrés dans data/outbox/ (pratique pour tester).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Expéditeur des e-mails, ex. "GCS Montpellier <contact@votre-domaine.fr>"
MAIL_FROM=
# Adresse qui reçoit les notifications (nouvelles commandes, demandes de devis…)
MAIL_ADMIN=

# Dossier des données (produits, commandes…). Par défaut : ./data
# DATA_DIR=/chemin/vers/un/disque/persistant

# Mode démo (paiement simulé) en production : à ne JAMAIS activer sur le site public.
# PAIEMENT_DEMO=1
